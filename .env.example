# ============================================================
#  Camarim — LA Music · Template de variáveis de ambiente
# ============================================================
#  Copie este arquivo para .env.local e preencha com os
#  valores reais (Supabase → Settings → API Keys).
#
#  .env.local está no .gitignore e NUNCA sobe para o Git.
#
#  ⚠️  SERVICE_ROLE e ACCESS_TOKEN são chaves de admin do banco.
#      Ficam só no .env.local e no painel do Supabase.
#      No navegador / Netlify, só a ANON_KEY.
# ============================================================

# --- Público (pode ir para o frontend / navegador) ---
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_PROJECT_ID=SEU_PROJECT_ID
SUPABASE_REGION=sa-east-1
SUPABASE_ANON_KEY=cole_a_anon_key_aqui
SUPABASE_PUBLISHABLE_KEY=cole_a_publishable_key_aqui

# --- SECRETO (só servidor / CLI / Edge Function — NUNCA no navegador) ---
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui
SUPABASE_ACCESS_TOKEN=sbp_cole_o_access_token_aqui
